<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 YaBrowser/25.12.0.0 Safari/537.36" version="29.2.9">
  <diagram name="Философия фронтира" id="4RfuDabQ6ldg-vt1GhMe">
    <mxGraphModel dx="1347" dy="649" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="RLnWsH7m7D7JRklDWfPd-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" value="Философия фронтира: цифровая культура ↔ адаптация общества ↔" vertex="1">
          <mxGeometry height="30" width="1440" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" value="рост благосостояния (через предпринимательство)" vertex="1">
          <mxGeometry height="30" width="1440" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" value="Вариант С: &quot;palabre&quot; как технология слушания и примирения; фронтир регулирует внедрение цифровой культуры через рост предпринимательской активности и благосостояния." vertex="1">
          <mxGeometry height="35" width="1440" x="40" y="95" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-32" edge="1" parent="1" source="RLnWsH7m7D7JRklDWfPd-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="RLnWsH7m7D7JRklDWfPd-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=13;arcSize=15;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Платформа государственного регулирования&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Нормы, право, стандарты&lt;br&gt;• Институты: образование, занятость, финансы&lt;br&gt;• Защита прав, &quot;красные линии&quot; (запрет насилия)&lt;br&gt;• Инструменты: стимулы, ограничения, услуги&lt;br&gt;&lt;br&gt;&lt;font style=&quot;&quot;&gt;Роль: рамка, безопасность, предсказуемость&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="220" width="330" x="110" y="150" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=13;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Платформа предпринимательства&lt;/b&gt;&lt;br&gt;&lt;br&gt;• МСП, самозанятость, кооперации&lt;br&gt;• Цифровые сервисы: платежи, торговля, логистика&lt;br&gt;• Новые практики труда и обмена&lt;br&gt;• Канал роста доходов и доверия&lt;br&gt;&lt;br&gt;&lt;font style=&quot;&quot;&gt;Роль: экономическая интеграция и благосостояние&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="360" x="1100" y="170" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=13;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Социально-культурная основа (общество)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Общинность, устная традиция, контекстность&lt;br&gt;• Идентичности, ритуалы, доверие&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="350" x="1100" y="405" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#555555;strokeWidth=2;align=center;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Фронтир (адаптационный контур)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Регулирует воздействие цифровой культуры: снижает риски взаимопроникновения и поддерживает рост благосостояния через предпринимательство&lt;/font&gt;" vertex="1">
          <mxGeometry height="760" width="590" x="465" y="140" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a4b7a;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;" value="&lt;font&gt;&lt;b style=&quot;&quot;&gt;Фактор 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Риск&lt;br&gt;&lt;font style=&quot;&quot;&gt;(вероятность × ущерб)&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="175" x="495" y="250" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a4b7a;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;" value="&lt;font&gt;&lt;b style=&quot;&quot;&gt;Фактор 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Бюджет&lt;br&gt;&lt;font style=&quot;&quot;&gt;(ресурсное ограничение)&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="165" x="680" y="250" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a4b7a;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;" value="&lt;font&gt;&lt;b style=&quot;&quot;&gt;Фактор 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Фронтир&lt;br&gt;&lt;font style=&quot;&quot;&gt;(новизна/неопределённость)&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="180" x="855" y="250" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-36" edge="1" parent="1" source="RLnWsH7m7D7JRklDWfPd-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="RLnWsH7m7D7JRklDWfPd-10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#444444;strokeWidth=2;align=center;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=13;" value="&lt;b&gt;Функции фронтира&lt;/b&gt;" vertex="1">
          <mxGeometry height="170" width="540" x="495" y="360" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Регистрация&lt;/b&gt;&lt;br&gt;&lt;br&gt;Где растёт напряжение?&lt;br&gt;Какие разрывы в институтах&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="155" x="515" y="405" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Перевод&lt;/b&gt;&lt;br&gt;&lt;br&gt;Гибридные институты и практики совместимости&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="155" x="690" y="405" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Темп&lt;/b&gt;&lt;br&gt;&lt;br&gt;Управление скоростью и пределом внедрения&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="155" x="865" y="405" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Палабр-контур (palabre): публичное слушание и примирение&lt;/b&gt;&lt;br&gt;&lt;br&gt;Решение возникает как восстановление согласия (а не как &quot;вердикт&quot;):&lt;br&gt;• слушание нарративов и признание мотивов&lt;br&gt;• признание ущерба: символического и практического&lt;br&gt;• выработка консенсуса и локальная легитимация&lt;br&gt;• настройка темпа/пределов внедрения и распределения выгод&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="540" x="495" y="560" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Метрики фронтира&lt;/b&gt;&lt;br&gt;&lt;br&gt;По природе несовершенны: используются как сигналы (раннее обнаружение), а не как &quot;судебные доказательства&quot;; требуют интерпретации и согласования в палабр-контуре&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="540" x="495" y="750" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Риски фронтира (болезненность процесса)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Несовпадение когнитивных режимов и кодов обучения&lt;br&gt;• Институциональные разрывы (школа, рынок труда, финансы)&lt;br&gt;• Темп внедрения &amp;gt; темпа адаптации практик&lt;br&gt;• Нормативное сопротивление и недоверие к институтам&lt;br&gt;• Уход в теневые практики и неформальные посредники&lt;br&gt;• Эскалация из-за &quot;метрик-вердиктов&quot; и санкционной логики&lt;br&gt;&lt;br&gt;&lt;font style=&quot;&quot;&gt;Смысл: риск — в несостыковке систем; &quot;когнитивные слабости&quot; проявляются как структурная несовместимость&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="350" width="350" x="90" y="490" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Целевой эффект (выход фронтира)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Рост предпринимательской активности&lt;br&gt;• Рост доходов и благосостояния&lt;br&gt;• Рост доверия к институтам (через результат)&lt;br&gt;• Снижение остроты культурных конфликтов&lt;br&gt;&lt;br&gt;&lt;font style=&quot;&quot;&gt;Принцип: платформа учится культуре быстрее, чем культура — платформе; выгоды распределяются прозрачно&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="400" x="1090" y="580" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a2d2d;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" value="&lt;b&gt;Синтез&lt;/b&gt;&lt;br&gt;&lt;br&gt;Фронтир регулирует внедрение цифровой культуры не напрямую, а через экономический канал: предпринимательство → рост благосостояния → рост доверия. Процесс болезненный из-за структурной когнитивной несовместимости и институциональных разрывов; &quot;палабр-контур&quot; обеспечивает примирение и настройку темпа/пределов внедрения. Метрики выполняют сигнальную функцию и требуют интерпретации: они не &quot;судебные доказательства&quot;, а индикаторы для коррекции траектории." vertex="1">
          <mxGeometry height="140" width="1440" x="40" y="920" as="geometry" />
        </mxCell>
        <mxCell id="RLnWsH7m7D7JRklDWfPd-22" edge="1" parent="1" source="RLnWsH7m7D7JRklDWfPd-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;endArrow=classic;endFill=1;" target="RLnWsH7m7D7JRklDWfPd-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
